{
  "manifest_version": 3,
  "name": "Autonomous AI Browser Agent",
  "description": "AI-powered autonomous Chrome browser assistant for DOM-aware web actions and multi-step research.",
  "version": "1.0.0",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Open AI Agent sidebar"
    }
  },
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "AI Agent"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "executor.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
